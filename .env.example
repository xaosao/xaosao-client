NODE_ENV="environment"

# Database
DATABASE_URL="mongo_db_url"

# SECRET KEYS
SESSION_SECRET="secret_key"
MODEL_SESSION_SECRET="model_secret_key"
GOOGLE_MAPS_API_KEY="google_map_key"

#ipapi-email: paokue77@gmail.coms
APIIP_API_KEY="api_ip"

# Geolocation Testing (for local development)
GEOLOCATION_TEST_IP="103.58.149.0"  # Laos Internet IP for testing

#Bunny CDN
BUNNY_STORAGE_ZONE="storage_zone"
BUNNY_API_KEY="bunny_api_key"
BUNNY_CDN_HOST="cdn_host"
BUNNY_BASE_HOSTNAME="bunny_hostname"

#Telbiz
TELBIZ_CLIENT_ID="telbiz_id"
TELBIZ_SECRETKEY="telbiz_secret"

# Chat APIs:
VITE_API_URL="backend_api_endpoint/api/"
VITE_SOCKET_URL="backend_socket_endpoint/"
VITE_Google_Client_ID="google_client_id"
VITE_Google_MAP_KEY="google_map_key"

# Chat URLs
VITE_CHAT_URL="chat_endpoint/"

# Xaosao Frontend
VITE_FRONTEND_URL="xaosao_client_endpoint/"

# Email (SMTP for Gmail)
SMTP_USER="your_gmail@gmail.com"
SMTP_PASS="your_gmail_app_password"
ADMIN_URL="admin_url"

# Push Notifications (Web Push API - VAPID Keys)
# Generate your own keys with: npx web-push generate-vapid-key
VAPID_PUBLIC_KEY="your_vapid_public_key"
VAPID_PRIVATE_KEY="your_vapid_private_key"
VAPID_EMAIL="mailto:your_email@example.com"

BYPASS_CHAT_SERVER="boolen"

# SSE API Secret (must match admin):
SSE_API_SECRET="xaosao-sse-secret-2024-subscription-activation"

# Referral Commission Thresholds
# Local (development):
MIN_REFERRED_MODELS_FOR_COMMISSION=number
MIN_EARNINGS_FOR_PARTNER_COMMISSION=number
#
# Production (uncomment when deploying):
# MIN_REFERRED_MODELS_FOR_COMMISSION=20
# MIN_EARNINGS_FOR_PARTNER_COMMISSION=1000000

TWILIO_ACCOUNT_SID="string"
TWILIO_AUTH_TOKEN="string"
TWILIO_WHATSAPP_FROM="string"

# ── xs_backend (chat + notification APIs, same backend the mobile app uses) ──
# Local: the NestJS server runs on PORT=3033 with prefix /api + version v1.
# Production: https://api.xaosao.com/api/v1/
XS_API_URL="backend_api_endpoint/api/v1/"
# Origin for the socket.io /chat namespace. Defaults to XS_API_URL's origin
# when unset. Production: https://api.xaosao.com
XS_SOCKET_URL="backend_origin"
# Must match xs_backend/.env exactly — the website signs its own access tokens
# for the chat/notification APIs (see app/services/xs-jwt.server.ts).
JWT_SECRET_CLIENT="same_as_xs_backend_JWT_SECRET_CLIENT"
JWT_SECRET_MODEL="same_as_xs_backend_JWT_SECRET_MODEL"